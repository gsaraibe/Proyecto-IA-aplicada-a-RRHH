# ===========================================
# CH Assist — Variables de entorno de ejemplo
# Copiá este archivo como .env y completá los valores
# ===========================================

# Backend
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/chassist
JWT_SECRET=cambia-esto-por-una-clave-secreta-segura-minimo-32-chars
FRONTEND_URL=http://localhost:3000

# Inteligencia Artificial (Claude / Anthropic)
# Obtené tu clave en https://console.anthropic.com
# También podés configurarla desde la app en Configuración > API Key IA
API_KEY_IA=tu-clave-de-api-aqui

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
